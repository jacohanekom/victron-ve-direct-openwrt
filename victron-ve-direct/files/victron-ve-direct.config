# /etc/config/victron-ve-direct
#
# Changes take effect after: /etc/init.d/victron-ve-direct reload
# (LuCI's "Save & Apply" does this automatically.)

config device 'device'
	option port        '/dev/ttyUSB0'
	option baud        '19200'
	option retry_secs  '5'

config output 'output'
	option ctrl_port '8562'
	option data_port '8563'

config control 'control'
	# Allow writing device settings (set/setraw/restart) over ctrl_port.
	# Reads (status/settings/get/list/ping) are always allowed. The
	# control port listens on 0.0.0.0, so consider this on shared
	# networks.
	option allow_set '1'

config mdns 'mdns'
	option enabled '1'
	option name    'victron-ve-direct'
